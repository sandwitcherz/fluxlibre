{
  "name": "fluxlibre",
  "version": "0.1.0",
  "private": true,
  "description": "Gestionnaire d'annonces libre et local pour Leboncoin et Vinted",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter @fluxlibre/backend dev",
    "dev:extension": "pnpm --filter @fluxlibre/extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@9.12.0"
}
